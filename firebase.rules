rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow anyone to read all public data
    match /{document=**} {
      allow read: if true;
    }
    
    // Allow any authenticated user to create, update, or delete data
    // This allows project owners to update bugs, and hunters to update project metrics.
    match /{document=**} {
      allow write: if request.auth != null;
    }
  }
}
